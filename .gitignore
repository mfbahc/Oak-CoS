.DS_Store
.env
.env.*
!.env.example

# Private Oak state. These are generated by onboarding and must stay local.
workspace/
local/
.oak/

# Common runtime/cache folders.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
node_modules/

# Logs and temporary output.
*.log
tmp/
dist/
build/

# This repo intentionally tracks public agent instructions and schemas even if a
# developer has broader global ignore rules.
!AGENTS.md
!core/schemas/
!core/schemas/*.json
!eval/
!eval/fixtures/
!eval/fixtures/*.json
!eval/fixtures/*.txt
