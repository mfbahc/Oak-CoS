#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

from oak_common import VERSION, ensure_dir, now_stamp, root_path, sanitize_output, section, write_json


def run(args: list[str], *, timeout: float = 45.0) -> tuple[int, str, float]:
    start = time.perf_counter()
    try:
        result = subprocess.run(
            args,
            cwd=root_path(),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
        )
        return result.returncode, result.stdout, time.perf_counter() - start
    except subprocess.TimeoutExpired as exc:
        output = exc.stdout if isinstance(exc.stdout, str) else ""
        return 124, output + "\ncommand timed out", time.perf_counter() - start


def git_output(args: list[str], *, timeout: float = 15.0) -> str:
    code, output, _ = run(["git", *args], timeout=timeout)
    if code != 0:
        return ""
    return output.strip()


def git_ok(args: list[str], *, timeout: float = 15.0) -> bool:
    code, _, _ = run(["git", *args], timeout=timeout)
    return code == 0


def write_report(report: dict[str, Any]) -> None:
    out_dir = root_path(".oak", "updates")
    ensure_dir(out_dir)
    write_json(out_dir / "latest-update.json", report, backup=False)
    lines = [
        "# Oak Update Report",
        "",
        f"Generated at: {report['generated_at']}",
        f"Oak version: {report['oak_version']}",
        f"Mode: {report['mode']}",
        f"Status: {report['status']}",
        "",
        "## Git",
        "",
        f"- Branch: {report['git'].get('branch', 'unknown')}",
        f"- Upstream: {report['git'].get('upstream', 'none')}",
        f"- Relation: {report['git'].get('relation', 'unknown')}",
        f"- Local revision: {report['git'].get('local', 'unknown')}",
        f"- Upstream revision: {report['git'].get('remote', 'unknown')}",
        "",
        "## Actions",
        "",
    ]
    lines.extend([f"- {item}" for item in report.get("actions", [])] or ["- none"])
    lines.extend(["", "## Next Step", "", str(report.get("next_step", "none"))])
    errors = report.get("errors", [])
    if errors:
        lines.extend(["", "## Errors", ""])
        lines.extend([f"- {sanitize_output(str(item))}" for item in errors])
    (out_dir / "latest-update.md").write_text("\n".join(lines) + "\n", encoding="utf-8")


def classify_relation(local_rev: str, upstream_rev: str) -> str:
    if not local_rev or not upstream_rev:
        return "unknown"
    if local_rev == upstream_rev:
        return "up-to-date"
    if git_ok(["merge-base", "--is-ancestor", local_rev, upstream_rev]):
        return "behind"
    if git_ok(["merge-base", "--is-ancestor", upstream_rev, local_rev]):
        return "ahead"
    return "diverged"


def collect_git_state(*, fetch: bool) -> tuple[dict[str, str], list[str], list[str]]:
    actions: list[str] = []
    errors: list[str] = []
    if not git_ok(["rev-parse", "--is-inside-work-tree"]):
        errors.append("This folder is not a git repository. Reinstall from the public repo or use a git clone for updates.")
        return {}, actions, errors

    branch = git_output(["branch", "--show-current"]) or "detached"
    upstream = git_output(["rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"])
    remote_url = ""
    if upstream and "/" in upstream:
        remote_name = upstream.split("/", 1)[0]
        remote_url = git_output(["remote", "get-url", remote_name])

    if fetch and upstream:
        code, output, elapsed = run(["git", "fetch", "--prune"], timeout=60.0)
        actions.append(f"checked remote updates with git fetch --prune ({elapsed:.2f}s)")
        if code != 0:
            errors.append("git fetch failed:\n" + output.strip())

    local_rev = git_output(["rev-parse", "--short", "HEAD"])
    upstream_rev = git_output(["rev-parse", "--short", upstream]) if upstream else ""
    relation = classify_relation(local_rev, upstream_rev) if upstream else "no-upstream"
    dirty = git_output(["status", "--porcelain"])
    return (
        {
            "branch": branch,
            "upstream": upstream,
            "remote_url": remote_url,
            "local": local_rev,
            "remote": upstream_rev,
            "relation": relation,
            "dirty": "yes" if dirty else "no",
            "dirty_detail": dirty,
        },
        actions,
        errors,
    )


def run_step(label: str, args: list[str], *, timeout: float, actions: list[str], errors: list[str]) -> bool:
    code, output, elapsed = run(args, timeout=timeout)
    actions.append(f"{label} ({elapsed:.2f}s)")
    if code != 0:
        errors.append(f"{label} failed:\n{output.strip()}")
        return False
    return True


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Check for and apply safe Oak public-core updates without touching private workspace state."
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check-only", action="store_true", help="Check update status and write a local report. Default.")
    mode.add_argument("--apply", action="store_true", help="Apply a fast-forward update, then run upgrade, QMD refresh, and doctor.")
    parser.add_argument("--no-fetch", action="store_true", help="Do not contact the remote; compare against local remote refs only.")
    parser.add_argument("--allow-dirty", action="store_true", help="Allow applying with modified public-core files. Not recommended.")
    parser.add_argument("--skip-qmd", action="store_true", help="Do not run scripts/qmd-update after applying.")
    parser.add_argument("--skip-doctor", action="store_true", help="Do not run scripts/doctor after applying.")
    parser.add_argument("--json", action="store_true", help="Print machine-readable JSON.")
    args = parser.parse_args()

    apply_update = bool(args.apply)
    check_only = not apply_update
    actions: list[str] = []
    errors: list[str] = []
    git_state, git_actions, git_errors = collect_git_state(fetch=not args.no_fetch)
    actions.extend(git_actions)
    errors.extend(git_errors)

    next_step = "No action taken."
    status = "passed"

    if git_state:
        relation = git_state.get("relation", "unknown")
        if check_only:
            dirty_suffix = " Local public-core edits are present; review them before applying updates." if git_state.get("dirty") == "yes" else ""
            if relation == "behind":
                next_step = "Updates are available. Ask Oak to update, or run ./scripts/update --apply." + dirty_suffix
            elif relation == "up-to-date":
                next_step = "Oak is already up to date." + dirty_suffix
            elif relation == "no-upstream":
                next_step = "No upstream is configured. Use a git clone with an origin remote to receive updates."
            elif relation in {"ahead", "diverged"}:
                next_step = "Local public-core commits differ from upstream. Review with git status/log before updating."
            else:
                next_step = "Could not determine update state. Review the errors and git remote configuration."
        else:
            if relation == "no-upstream":
                errors.append("Cannot apply updates because no upstream remote is configured.")
            elif relation in {"ahead", "diverged", "unknown"}:
                errors.append(f"Cannot safely fast-forward from relation: {relation}.")
            elif git_state.get("dirty") == "yes" and not args.allow_dirty:
                errors.append("Public-core files have local changes. Commit, discard, or rerun with --allow-dirty after review.")
            elif relation == "up-to-date":
                actions.append("no git update needed; local core already matches upstream")
                next_step = "No git update was needed. Upgrade and checks were still run."
            elif relation == "behind":
                run_step("git pull --ff-only", ["git", "pull", "--ff-only"], timeout=60.0, actions=actions, errors=errors)

            if not errors:
                run_step("upgrade dry-run", [str(root_path("scripts", "upgrade")), "--dry-run"], timeout=30.0, actions=actions, errors=errors)
            if not errors:
                run_step("upgrade", [str(root_path("scripts", "upgrade"))], timeout=30.0, actions=actions, errors=errors)
            if not errors and not args.skip_qmd and root_path("scripts", "qmd-update").exists():
                run_step("qmd update", [str(root_path("scripts", "qmd-update"))], timeout=30.0, actions=actions, errors=errors)
            if not errors and not args.skip_doctor:
                run_step("doctor", [str(root_path("scripts", "doctor"))], timeout=45.0, actions=actions, errors=errors)
            if not errors:
                next_step = "Update applied. Restart or refresh your Codex/Claude session so it reloads the updated core instructions."

    if errors:
        status = "failed" if apply_update else "warning"

    report: dict[str, Any] = {
        "oak_version": VERSION,
        "generated_at": now_stamp(),
        "mode": "apply" if apply_update else "check-only",
        "status": status,
        "git": git_state,
        "actions": actions,
        "errors": errors,
        "next_step": next_step,
    }
    write_report(report)

    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        section("Oak update")
        print(f"status: {status}")
        if git_state:
            print(f"branch: {git_state.get('branch', 'unknown')}")
            print(f"upstream: {git_state.get('upstream', 'none') or 'none'}")
            print(f"relation: {git_state.get('relation', 'unknown')}")
            print(f"dirty public core: {git_state.get('dirty', 'unknown')}")
        for item in actions:
            print(f"- {item}")
        print(f"next: {next_step}")
        print("report: .oak/updates/latest-update.md")
        if errors:
            print("issues:")
            for item in errors:
                print(f"- {sanitize_output(item)}")

    return 1 if apply_update and errors else 0


if __name__ == "__main__":
    raise SystemExit(main())
