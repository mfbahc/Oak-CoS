def check_public_demo_no_connector_dependency(gate: Gate) -> None:
    for script_name in ["qmd-setup", "privacy-audit", "demo", "upgrade", "update"]:
        text = read(f"scripts/{script_name}").lower()
        forbidden = ["gmail", "slack", "calendar api", "drive api", "granola token", "discord token", "whatsapp token", "telegram token"]
        for word in forbidden:
            if word in text and script_name not in {"onboard"}:
                gate.fail(f"public demo script appears to depend on connector term '{word}': scripts/{script_name}")


def check_rerun_and_upgrade_safety(gate: Gate) -> None:
    custom = root_path("workspace", "projects", "custom-project.md")
    custom.parent.mkdir(parents=True, exist_ok=True)
    custom.write_text("# Custom Project\n\nPrivate local customization placeholder.\n", encoding="utf-8")
    profile = root_path("local", "profile.toml")
    profile.write_text(profile.read_text(encoding="utf-8") + "\n# local customization marker\n", encoding="utf-8")
    gate.run("onboarding rerun", [str(root_path("scripts", "onboard")), "--demo"], timeout=20.0)
    if not custom.exists():
        gate.fail("onboarding rerun removed a custom workspace file")
    backups = list(root_path(".oak", "backups").glob("*/local__profile.toml"))
    if not backups:
        gate.fail("onboarding rerun did not back up a changed local profile")
    gate.run("upgrade", [str(root_path("scripts", "upgrade"))], timeout=20.0)
    if not custom.exists():
        gate.fail("upgrade removed a custom workspace file")
    gate.run("upgrade dry-run", [str(root_path("scripts", "upgrade")), "--dry-run"], timeout=20.0)


def check_update_flow(gate: Gate) -> None:
    update = root_path("scripts", "update")
    if not update.exists():
        gate.fail("missing scripts/update")
        return
    help_text = gate.run("update help", [str(update), "--help"], timeout=10.0)
    for phrase in ["--check-only", "--apply", "--no-fetch", "--json", "--allow-dirty"]:
        if phrase not in help_text:
            gate.fail(f"scripts/update help missing flag: {phrase}")
    output = gate.run("update check no-fetch", [str(update), "--check-only", "--no-fetch", "--json"], timeout=20.0)
    try:
        payload = json.loads(output)
    except json.JSONDecodeError:
        gate.fail("scripts/update --json did not return valid JSON")
        return
    if payload.get("mode") != "check-only":
        gate.fail("scripts/update --check-only report has wrong mode")
    if "git" not in payload or "next_step" not in payload:
        gate.fail("scripts/update report missing git state or next step")
    if not root_path(".oak", "updates", "latest-update.md").exists():
        gate.fail("scripts/update did not write .oak/updates/latest-update.md")
    updates = read("docs/upgrades.md").lower()
    readme = read("README.md").lower()
    prompt_bible = read("docs/prompt-bible.md").lower()
    for phrase in ["check for oak updates", "./scripts/update --check-only", "./scripts/update --apply"]:
        if phrase not in updates or phrase not in readme or phrase not in prompt_bible:
            gate.fail(f"update docs missing phrase across README/upgrades/prompt bible: {phrase}")


def check_runtime_update_parity(gate: Gate) -> None:
    required = [
        "check for updates",
        "./scripts/update",
        "core/skills/oak-update/SKILL.md",
        "restart",
    ]
    runtime_docs = ["docs/codex.md", "docs/codex-cli.md", "docs/claude-cli.md", "docs/claude-desktop.md"]
    for path in runtime_docs:
        text = read(path).lower()
        for phrase in required:
            if phrase.lower() not in text:
                gate.fail(f"{path} missing runtime-neutral update phrase: {phrase}")

    instruction_files = ["AGENTS.md", "CLAUDE.md"]
    for path in instruction_files:
        text = read(path).lower()
        if "./scripts/update --check-only" not in text or "./scripts/update --apply" not in text:
            gate.fail(f"{path} missing update command guidance")

    prompt_counts = {runtime: len(prompt.split()) for runtime, prompt in RUNTIME_PROMPTS.items()}
    if prompt_counts:
        shortest = min(prompt_counts.values())
        longest = max(prompt_counts.values())
        if longest > shortest * 1.8 + 30:
            gate.fail(f"runtime launch prompts are materially imbalanced: {prompt_counts}")


def check_generalized_workflow_skills(gate: Gate) -> None:
    skills = {
        "core/skills/oak-update/SKILL.md": ["check for updates", "./scripts/update --check-only", "./scripts/update --apply", "workspace/"],
        "core/skills/meeting-transcript-ingest/SKILL.md": ["raw source", "decisions", "commitments", "local search"],
        "core/skills/reading-queue/SKILL.md": ["mark", "read", "superseded", "source artifacts"],
        "core/skills/board-briefing-refresh/SKILL.md": ["agenda", "materials", "questions", "voting guidance"],
        "core/skills/session-launch/SKILL.md": ["fresh oak session", "current-actions.md", "do not import old chat", "first recommended action"],
        "core/skills/session-closeout/SKILL.md": ["wind down", "current-actions.md", "remove closed rows", "local search/qmd"],
    }
    forbidden = [
        "/users/",
        "resend",
        "gog",
        "granola safe storage",
    ]
    for path, phrases in skills.items():
        text = read(path)
        lower = text.lower()
        for phrase in phrases:
            if phrase not in lower:
                gate.fail(f"{path} missing expected phrase: {phrase}")
        for phrase in forbidden:
            if phrase in lower:
                gate.fail(f"{path} contains private or over-specific phrase: {phrase}")


def check_current_actions_layer(gate: Gate) -> None:
    required_paths = [
        "workspace.template/context/current-actions.md",
        "core/templates/current-actions.md",
        "core/skills/session-launch/SKILL.md",
        "core/skills/session-closeout/SKILL.md",
    ]
    for path in required_paths:
        if not root_path(path).exists():
            gate.fail(f"missing current-actions support file: {path}")
            return

    combined = "\n".join(
        read(path)
        for path in [
            "AGENTS.md",
            "CLAUDE.md",
            "docs/context-management.md",
            "docs/operating-state.md",
            "docs/prompt-bible.md",
            "workspace.template/context/current-actions.md",
        ]
    ).lower()
    for phrase in [
        "current-actions.md",
        "sign / check / flag / wait",
        "keep this short",
        "details belong",
        "do not import old chat",
        "remove closed rows",
    ]:
        if phrase not in combined:
            gate.fail(f"current-actions layer missing phrase: {phrase}")

    template = read("workspace.template/context/current-actions.md")
    active_rows = [
        line
        for line in template.splitlines()
        if line.startswith("|") and not line.startswith("| ---") and "Item" not in line
    ]
    if len(active_rows) > 12:
        gate.fail(f"workspace template current-actions has too many active rows: {len(active_rows)} > 12")
    if len(template.split()) > 180:
        gate.fail(f"workspace template current-actions is too verbose: {len(template.split())} words > 180")


def check_session_lifecycle_guidance(gate: Gate) -> None:
    launch = read("core/skills/session-launch/SKILL.md").lower()
    closeout = read("core/skills/session-closeout/SKILL.md").lower()
    prompt_bible = read("docs/prompt-bible.md").lower()
    for phrase in ["durable local state", "without importing prior chat context", "current-actions.md", "first recommended action"]:
        if phrase not in launch:
            gate.fail(f"session-launch skill missing phrase: {phrase}")
    for phrase in ["wind down", "current-actions.md", "remove closed rows", "no external sends"]:
        if phrase not in closeout:
            gate.fail(f"session-closeout skill missing phrase: {phrase}")
    for phrase in ["fresh session launch", "session closeout", "workspace/context/current-actions.md"]:
        if phrase not in prompt_bible:
            gate.fail(f"prompt bible missing session lifecycle phrase: {phrase}")


