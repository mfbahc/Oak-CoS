#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

from oak_common import (
    LOCAL_TEMPLATE_NAMES,
    RELEASE_TIME_TARGET_SECONDS,
    REQUIRED_PATHS,
    ROUTINES,
    RUNTIME_PROMPTS,
    VERSION,
    local_search,
    root_path,
    sanitize_output,
    section,
)


class Gate:
    def __init__(self, name: str) -> None:
        self.name = name
        self.failures: list[str] = []
        self.warnings: list[str] = []
        self.timings: list[tuple[str, float]] = []
        self.perf_report: dict[str, object] | None = None

    def fail(self, message: str) -> None:
        self.failures.append(message)

    def warn(self, message: str) -> None:
        self.warnings.append(message)

    def run(self, label: str, args: list[str], *, cwd: Path | None = None, timeout: float = 30.0) -> str:
        cwd = cwd or root_path()
        start = time.perf_counter()
        try:
            result = subprocess.run(
                args,
                cwd=cwd,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=timeout,
            )
        except subprocess.TimeoutExpired as exc:
            elapsed = time.perf_counter() - start
            self.timings.append((label, elapsed))
            output = exc.stdout if isinstance(exc.stdout, str) else ""
            self.fail(f"{label} timed out after {elapsed:.2f}s\n{sanitize_output(output)}")
            return output
        elapsed = time.perf_counter() - start
        self.timings.append((label, elapsed))
        if result.returncode != 0:
            self.fail(f"{label} failed with exit {result.returncode}\n{sanitize_output(result.stdout)}")
        return result.stdout


def read(path: str) -> str:
    return root_path(path).read_text(encoding="utf-8", errors="ignore")


def ensure_release_blocklist() -> None:
    candidates = [
        root_path(".oak", "release-check-blocklist.txt"),
        root_path(".oak", "privacy-blocklist.txt"),
        root_path("local", "privacy-blocklist.txt"),
    ]
    for path in candidates:
        if path.exists():
            terms = [
                line.strip()
                for line in path.read_text(encoding="utf-8", errors="ignore").splitlines()
                if line.strip() and not line.strip().startswith("#")
            ]
            if terms:
                return
    path = root_path(".oak", "release-check-blocklist.txt")
    path.parent.mkdir(parents=True, exist_ok=True)
    placeholder = f"LOCAL_RELEASE_BLOCK_{os.getpid()}_{int(time.time())}"
    path.write_text(
        "# Synthetic placeholder so release-check can run from a fresh clone.\n"
        "# Add maintainer-specific private names, emails, domains, projects, and paths here before public release.\n"
        f"{placeholder}\n",
        encoding="utf-8",
    )


def check_required_files(gate: Gate) -> None:
    for item in REQUIRED_PATHS:
        if not root_path(item).exists():
            gate.fail(f"missing required file: {item}")


def check_readme_beginner_path(gate: Gate) -> None:
    lines = read("README.md").splitlines()
    expected = [
        "# Oak",
        "## What is this?",
        "## What does it do?",
        "## How do I install it?",
        "## How do I launch it the first time?",
        "## What should I see after setup?",
    ]
    heading_lines = [line.strip() for line in lines if line.startswith("#")][: len(expected)]
    if heading_lines != expected:
        gate.fail("README must start with the required beginner-friendly section order")
    first_120 = "\n".join(lines[:120]).lower()
    required_phrases = [
        "path a",
        "path b",
        "which path should i choose",
        "download",
        "git clone https://",
        "ai tool",
        "export-public",
        "never zip",
        "github issues",
        "do not paste private",
        "skills, connectors, and routines",
        "skip any connector",
        "read-only or draft-only",
        "private local",
        "dedicated folder",
        "first daily brief",
        "do not send",
    ]
    for phrase in required_phrases:
        if phrase not in first_120:
            gate.fail(f"README first 120 lines missing beginner phrase: {phrase}")
    if "synthetic demo later" not in first_120:
        gate.fail("README must frame demo as optional/later, not the first user moment")


def check_runtime_docs_beginner_sections(gate: Gate) -> None:
    required_sections = [
        "## Who should use this path?",
        "## Before you start",
        "## Step by step",
        "## What to paste",
        "## How to know it worked",
        "## Common problems",
    ]
    for path in ["docs/codex.md", "docs/codex-cli.md", "docs/claude.md", "docs/claude-cli.md", "docs/claude-desktop.md"]:
        text = read(path)
        for section_name in required_sections:
            if section_name not in text:
                gate.fail(f"{path} missing section: {section_name}")
        lower = text.lower()
        if "recommended connectors" not in lower or "skip any connector" not in lower:
            gate.fail(f"{path} must make connectors recommended but skippable")


def check_connector_state_language(gate: Gate) -> None:
    connectors = read("docs/connectors.md").lower()
    required = [
        "documented",
        "selected in config",
        "actually connected in the runtime",
        "not active just because",
        "after web oauth",
        "restart or refresh",
        "verify actual availability",
        "connector state is runtime-specific",
        "recommended onboarding",
        "skippable",
        "day 1",
        "advanced",
        "manual-import/read-only only",
        "email connectors may expose message bodies but not attachments",
        "technical no-send guardrails",
        "transcript-adapters.md",
    ]
    for phrase in required:
        if phrase not in connectors:
            gate.fail(f"docs/connectors.md missing connector-state phrase: {phrase}")


def check_ignored_state(gate: Gate, cwd: Path | None = None) -> None:
    cwd = cwd or root_path()
    for item in ["workspace", "local", ".oak"]:
        result = subprocess.run(
            ["git", "check-ignore", item],
            cwd=cwd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        if result.returncode != 0:
            gate.fail(f"{item}/ is not ignored by git")
    result = subprocess.run(
        ["git", "ls-files", "workspace", "local", ".oak"],
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode == 0 and result.stdout.strip():
        gate.fail("generated private state is tracked by git:\n" + result.stdout.strip())


def check_prompt_generation(gate: Gate) -> None:
    prompt_file = root_path(".oak", "launch-prompts.md")
    if not prompt_file.exists():
        gate.fail(".oak/launch-prompts.md was not generated")
        return
    text = prompt_file.read_text(encoding="utf-8", errors="ignore")
    for runtime in RUNTIME_PROMPTS:
        if f"## {runtime}" not in text:
            gate.fail(f"generated launch prompts missing {runtime}")
    required_phrases = [
        "Guided App Onboarding",
        "Use QMD/local search before broad scans",
        "Do not send",
        "Keep private state",
        "Treat manifests as maps",
        "First Domain Or Project",
    ]
    for phrase in required_phrases:
        if phrase not in text:
            gate.fail(f"generated launch prompts missing safety phrase: {phrase}")


def check_search_first(gate: Gate) -> None:
    results = local_search("Example Project", limit=5)
    paths = [str(item.get("path", "")) for item in results]
    if not any("examples/synthetic-user" in path for path in paths):
        gate.fail("local search did not find synthetic Example Project notes")
    for path in ["AGENTS.md", "CLAUDE.md", "docs/context-management.md", "docs/prompt-bible.md"]:
        text = read(path)
        if "manifest" not in text.lower() or "search" not in text.lower():
            gate.fail(f"{path} does not state manifest/search-first discipline")


def check_external_action_defaults(gate: Gate) -> None:
    required = ["AGENTS.md", "CLAUDE.md", "README.md", "docs/connectors.md"]
    for path in required:
        text = read(path).lower()
        if "do not send" not in text and "no emails" not in text:
            gate.fail(f"{path} is missing the no-external-send default")


def check_docs_claims(gate: Gate) -> None:
    skills = read("docs/skills-and-plugins.md").lower()
    connectors = read("docs/connectors.md").lower()
    readme = read("README.md").lower()
    if "implemented public skills" not in skills or "recommended optional categories" not in skills:
        gate.fail("docs/skills-and-plugins.md must distinguish implemented skills from recommended categories")
    if "opt-in" not in connectors or "skippable" not in connectors or "default safety mode" not in connectors:
        gate.fail("docs/connectors.md must keep connectors clearly opt-in, skippable, and safety-scoped")
    if "docs/capability-matrix.md" not in readme:
        gate.fail("README must link the capability matrix")


def check_onboarding_issue_release_gate(gate: Gate) -> None:
    path = root_path("docs", "onboarding-issues-release-gate.md")
    if not path.exists():
        gate.fail("missing docs/onboarding-issues-release-gate.md")
        return
    text = path.read_text(encoding="utf-8", errors="ignore").lower()
    required_classes = [
        "connector auth reality",
        "runtime-specific connector state",
        "value-first onboarding",
        "assistant identity",
        "file placement",
        "pause/resume",
        "connector prepopulation",
        "email attachment limitations",
        "backup storage vs runtime path",
        "always-on host",
        "scheduled job reliability",
        "scheduled job safety",
        "delivery-channel reality",
        "messaging connectors",
        "email identity separation",
        "hard deny rules",
        "domain/project reconciliation",
        "local search freshness",
        "context refresh",
        "existing user settings",
        "runtime/model portability",
        "migration from an existing assistant",
    ]
    for phrase in required_classes:
        if phrase not in text:
            gate.fail(f"onboarding issue release gate missing issue class: {phrase}")
    for status in [
        "implemented and validated",
        "generalized into safe public guidance",
        "intentionally out of public starter scope",
        "blocked by external runtime/provider limitations",
    ]:
        if status not in text:
            gate.fail(f"onboarding issue release gate missing status: {status}")
    safety_phrases = [
        "restart-after-auth guidance",
        "per-runtime connector verification",
        "timeout/log/visible failure",
        "messaging manual-import/read-only",
        "technical no-send guidance",
        "assistant identity separated from user profile",
        "migration/retirement checklist",
    ]
    for phrase in safety_phrases:
        if phrase not in text:
            gate.fail(f"onboarding issue release gate missing release-check expectation: {phrase}")


def check_personality_onboarding(gate: Gate) -> None:
    onboard = read("scripts/onboard").lower()
    common = read("scripts/oak_common.py").lower()
    onboarding_doc = read("docs/onboarding.md").lower()
    readme = read("README.md").lower()
    template = read("core/templates/assistant-profile.md").lower()
    template_root = root_path("core", "personality-templates")
    for phrase in [
        "executive chief of staff",
        "research analyst",
        "engineering lead",
        "personal admin",
        "investor / board support",
        "founder operator",
        "legal/compliance conservative",
        "creative strategist",
        "executive coach",
        "custom / build my own",
    ]:
        if phrase not in common:
            gate.fail(f"personality template missing from onboarding constants: {phrase}")
    expected_files = [
        "executive-chief-of-staff.md",
        "research-analyst.md",
        "engineering-lead.md",
        "personal-admin.md",
        "investor-board-support.md",
        "founder-operator.md",
        "legal-compliance-conservative.md",
        "creative-strategist.md",
        "executive-coach.md",
        "custom-build-my-own.md",
    ]
    for filename in expected_files:
        path = template_root / filename
        if not path.exists():
            gate.fail(f"missing personality template: {filename}")
            continue
        text = path.read_text(encoding="utf-8", errors="ignore").lower()
        for section_name in ["## opening", "## core truths", "## boundaries", "## vibe", "## continuity", "## closing"]:
            if section_name not in text:
                gate.fail(f"{filename} missing soul-style section: {section_name}")
    template_readme = read("core/personality-templates/README.md").lower()
    for phrase in ["soul.md pattern", "assistant-identity.md", "custom identity", "private facts"]:
        if phrase not in template_readme:
            gate.fail(f"personality template README missing: {phrase}")
    for phrase in [
        "personality templates are starting points",
        "when it should challenge you",
        "render_personality_template",
        "copy_personality_templates",
    ]:
        if phrase not in onboard:
            gate.fail(f"onboarding script missing personality customization guidance: {phrase}")
    question_order = [
        "what should your assistant be called?",
        "choose a starting personality/work style.",
        "what personality/work style should it use?",
        "what should {assistant_name} call you?",
    ]
    positions = [onboard.find(phrase) for phrase in question_order]
    if any(position == -1 for position in positions):
        gate.fail("onboarding script missing expected early identity question order")
    elif positions != sorted(positions):
        gate.fail("onboarding must ask assistant name, personality, work style, then what the CoS should call the user")
    for phrase in ["custom / build my own", "assistant-identity.md", "tone", "challenge", "openclaw soul.md guide", "workspace/templates/personality"]:
        if phrase not in onboarding_doc:
            gate.fail(f"docs/onboarding.md missing custom personality guidance: {phrase}")
    flow_order = [
        "- assistant name",
        "- personality or work style",
        "- what the cos should call the user",
    ]
    flow_positions = [onboarding_doc.find(phrase) for phrase in flow_order]
    if any(position == -1 for position in flow_positions) or flow_positions != sorted(flow_positions):
        gate.fail("docs/onboarding.md must document early identity order: name, personality, user label")
    if "personality is customizable" not in readme or "core/personality-templates" not in readme:
        gate.fail("README must tell users Oak's personality is customizable")
    if "evolve the assistant" not in template:
        gate.fail("assistant profile template must explain how to evolve the assistant personality")
    for path in ["AGENTS.md", "CLAUDE.md", "docs/prompt-bible.md"]:
        if "workspace/context/assistant-identity.md" not in read(path):
            gate.fail(f"{path} must instruct runtimes to load assistant identity")


def check_capability_matrix(gate: Gate) -> None:
    path = root_path("docs", "capability-matrix.md")
    if not path.exists():
        gate.fail("missing docs/capability-matrix.md")
        return
    text = path.read_text(encoding="utf-8", errors="ignore")
    lower = text.lower()
    for status in ["implemented", "scaffolded", "connector-backed opt-in", "future/private extension"]:
        if status not in lower:
            gate.fail(f"capability matrix missing status label: {status}")
    claims = {
        "daily brief": ["core/skills/daily-brief/SKILL.md", "core/templates/daily-brief.md"],
        "meeting prep": ["core/skills/meeting-prep/SKILL.md", "core/templates/meeting-prep.md"],
        "inbox triage": ["core/skills/inbox-triage/SKILL.md", "core/templates/inbox-triage.md"],
        "writing style": ["core/skills/initial-inbox-scan/SKILL.md", "core/templates/writing-style-profile.md"],
        "transcript": ["core/skills/ingest/SKILL.md", "core/templates/transcript-ingest.md"],
        "meeting transcript ingest": ["core/skills/meeting-transcript-ingest/SKILL.md", "core/templates/transcript-ingest.md"],
        "transcript adapters": ["docs/transcript-adapters.md", "core/templates/transcript-adapter.md"],
        "first domain": ["core/skills/first-domain-project-setup/SKILL.md", "core/templates/first-domain-project.md"],
        "safe public-core updates": ["scripts/update", "scripts/upgrade", "core/skills/oak-update/SKILL.md", "docs/upgrades.md"],
        "reading queue": ["core/skills/reading-queue/SKILL.md"],
        "board briefing refresh": ["core/skills/board-briefing-refresh/SKILL.md"],
        "qmd/local search": ["scripts/qmd-setup", "scripts/qmd-update", "core/connectors/qmd.md"],
        "scheduled routine wrapper": ["core/templates/scheduled-routine-wrapper.sh", "docs/routines.md"],
        "clean public export": ["scripts/export-public"],
        "codex app": ["docs/codex.md"],
        "codex cli": ["docs/codex-cli.md"],
        "claude cli": ["docs/claude-cli.md"],
        "claude desktop": ["docs/claude-desktop.md"],
    }
    combined = (read("README.md") + "\n" + text).lower()
    for phrase, paths in claims.items():
        if phrase in combined:
            for required in paths:
                if not root_path(required).exists():
                    gate.fail(f"capability claim '{phrase}' missing support file: {required}")
    for connector in ["gmail", "calendar", "drive", "slack", "granola"]:
        if connector in combined and "connector-backed opt-in" not in lower:
            gate.fail(f"capability matrix must label {connector} as connector-backed opt-in")


def check_generated_outputs(gate: Gate) -> None:
    demo = root_path(".oak", "demo", "demo-output.md")
    if not demo.exists():
        gate.fail("demo output was not generated")
    else:
        text = demo.read_text(encoding="utf-8", errors="ignore")
        for phrase in ["Synthetic Daily Brief", "Synthetic Meeting Prep", "Sources read", "Synthetic Coaching Check-In"]:
            if phrase not in text:
                gate.fail(f"demo output missing {phrase}")
    for routine in ROUTINES:
        path = f"workspace/routines/{routine}.md"
        if not root_path(path).exists():
            gate.fail(f"onboarding did not copy expected routine: {path}")
    for template in LOCAL_TEMPLATE_NAMES:
        path = f"workspace/templates/{template}"
        if not root_path(path).exists():
            gate.fail(f"onboarding did not copy expected local file: {path}")
    first_brief = root_path("workspace", "artifacts", "daily-briefs", "example-project-first-brief.md")
    if not first_brief.exists():
        gate.fail("onboarding did not create the first starter brief artifact")
    else:
        text = first_brief.read_text(encoding="utf-8", errors="ignore")
        if "No live connector calls were made by onboarding" not in text:
            gate.fail("first starter brief must clarify onboarding did not call live connectors")
    for path in [
        "workspace/context/assistant-identity.md",
        "workspace/context/current-actions.md",
        "workspace/context/user-profile.md",
        "workspace/context/onboarding-safety.md",
        ".oak/onboarding-resume.md",
    ]:
        if not root_path(path).exists():
            gate.fail(f"onboarding did not generate required local guidance: {path}")

    safety = root_path("workspace", "context", "onboarding-safety.md")
    if safety.exists():
        lower = safety.read_text(encoding="utf-8", errors="ignore").lower()
        for phrase in [
            "after web oauth",
            "verify connector availability in each runtime",
            "scheduled wrappers should have timeouts",
            "email connectors may expose message bodies without attachment files",
            "manual-import/read-only only",
            "behavioral instructions are not enough",
            "restart or refresh the runtime",
            "retire old automations only after",
            "existing assistant context",
            "dedicated oak folder",
        ]:
            if phrase not in lower:
                gate.fail(f"generated onboarding safety notes missing: {phrase}")

    start_here = root_path(".oak", "START_HERE.md")
    if not start_here.exists():
        gate.fail("onboarding did not generate .oak/START_HERE.md")
    else:
        text = start_here.read_text(encoding="utf-8", errors="ignore")
        if len(text.splitlines()) > 90:
            gate.fail(f".oak/START_HERE.md is too long: {len(text.splitlines())} lines > 90")
        if len(text.split()) > 750:
            gate.fail(f".oak/START_HERE.md is too long: {len(text.split())} words > 750")
        for phrase in ["What Was Created", "Dedicated Folder Rule", "What To Open Next", "First Thing To Ask Oak", "Routine Scheduling", "Where Private Notes Go", "Connectors", "Safety Rule"]:
            if phrase not in text:
                gate.fail(f".oak/START_HERE.md missing section: {phrase}")
        if "first Oak domain or project" not in text:
            gate.fail(".oak/START_HERE.md must direct the first real use toward a domain/project")
        if "synthetic demo data" in text.lower():
            gate.fail(".oak/START_HERE.md should not make synthetic demo data the first user moment")


