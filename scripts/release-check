            gate.fail(f"synthetic worker handoff missing {phrase}")
    prompt_bible = read("docs/prompt-bible.md")
    if "Open at most the files needed" not in prompt_bible or "sources read" not in prompt_bible.lower():
        gate.fail("worker prompt does not enforce bounded context and source reporting")


def check_routine_safety(gate: Gate) -> None:
    docs = read("docs/routines.md").lower()
    if "opt-in" not in docs or "do not send" not in docs or "external" not in docs:
        gate.fail("docs/routines.md must state opt-in and no-external-action safety")
    for phrase in ["always-on", "sleeps", "hosted scheduler", "manual/on-demand"]:
        if phrase not in docs:
            gate.fail(f"docs/routines.md missing scheduling host limitation phrase: {phrase}")
    for phrase in ["hard timeout", "write logs", "visible failure", "never wait for stdin", "interactive permission prompt", "avoid injecting text"]:
        if phrase not in docs:
            gate.fail(f"docs/routines.md missing scheduled-job reliability phrase: {phrase}")
    for routine in ROUTINES:
        path = f"core/routines/{routine}.md"
        if not root_path(path).exists():
            gate.fail(f"missing public routine: {path}")
            continue
        text = read(path).lower()
        if "default output" not in text:
            gate.fail(f"{path} missing default local output")
        if "do not" not in text and "without approval" not in text:
            gate.fail(f"{path} missing external-action safety rule")
    wrapper_path = root_path("core", "templates", "scheduled-routine-wrapper.sh")
    if not wrapper_path.exists():
        gate.fail("missing scheduled routine wrapper template")
    else:
        wrapper = wrapper_path.read_text(encoding="utf-8", errors="ignore").lower()
        for phrase in [
            "hard timeout",
            "write logs",
            "visible failure",
            "never wait for stdin",
            "avoid interactive permission prompts",
            "avoid injecting text",
            "scripts/qmd-update",
            "do not send",
            "oak_root",
        ]:
            if phrase not in wrapper:
                gate.fail(f"scheduled routine wrapper missing safety phrase: {phrase}")
    if "scheduled-routine-wrapper.sh" not in docs:
        gate.fail("docs/routines.md must point users to the scheduled routine wrapper template")


def check_public_templates(gate: Gate) -> None:
    required = {
        "first-domain-project.md",
        "daily-brief.md",
        "meeting-prep.md",
        "transcript-ingest.md",
        "transcript-adapter.md",
        "inbox-triage.md",
        "weekly-retro.md",
        "board-project-brief.md",
        "decision-memo.md",
        "relationship-note.md",
        "travel-logistics-plan.md",
        "domain-tracker.md",
        "current-actions.md",
    }
    missing = sorted(template for template in required if not root_path("core", "templates", template).exists())
    for template in missing:
        gate.fail(f"missing required public template: core/templates/{template}")
    for template in required:
        path = root_path("core", "templates", template)
        if path.exists():
            text = path.read_text(encoding="utf-8", errors="ignore")
            if "{{" not in text:
                gate.fail(f"template lacks placeholders: core/templates/{template}")


def check_transcript_adapter_contract(gate: Gate) -> None:
    docs_path = root_path("docs", "transcript-adapters.md")
    template_path = root_path("core", "templates", "transcript-adapter.md")
    skill_path = root_path("core", "skills", "meeting-transcript-ingest", "SKILL.md")
    for path in [docs_path, template_path, skill_path]:
        if not path.exists():
            gate.fail(f"missing transcript adapter support file: {path.relative_to(root_path())}")
            return
    docs = docs_path.read_text(encoding="utf-8", errors="ignore").lower()
    template = template_path.read_text(encoding="utf-8", errors="ignore").lower()
    skill = skill_path.read_text(encoding="utf-8", errors="ignore").lower()
    for phrase in [
        "check",
        "list",
        "export",
        "never print secrets",
        "local/extensions",
        "workspace/extensions",
        "preserve raw transcript",
        "refresh local search/qmd",
        "fail closed",
    ]:
        if phrase not in docs:
            gate.fail(f"docs/transcript-adapters.md missing contract phrase: {phrase}")
    for phrase in ["{{provider_name}}", "{{runtime_name}}", "{{default_artifact_folder}}", "do not print secrets"]:
        if phrase not in template:
            gate.fail(f"core/templates/transcript-adapter.md missing template phrase: {phrase}")
    if "docs/transcript-adapters.md" not in skill:
        gate.fail("meeting transcript ingest skill must reference transcript adapter contract")


