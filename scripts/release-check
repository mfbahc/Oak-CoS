def check_doctor_non_mutating(gate: Gate) -> None:
    sentinel = f"DOCTOR_NON_MUTATING_SENTINEL_{os.getpid()}_{int(time.time())}"
    sentinel_targets = {
        ".oak/START_HERE.md": f"\n<!-- {sentinel} -->\n",
        ".oak/launch-prompts.md": f"\n<!-- {sentinel} -->\n",
        "local/profile.toml": f"\n# {sentinel}\n",
        "workspace/context/assistant-identity.md": f"\n<!-- {sentinel} -->\n",
    }
    for item, marker in sentinel_targets.items():
        path = root_path(item)
        if path.exists():
            path.write_text(path.read_text(encoding="utf-8", errors="ignore") + marker, encoding="utf-8")
    watched = [
        ".oak/START_HERE.md",
        ".oak/launch-prompts.md",
        ".oak/onboarding-review.md",
        ".oak/onboarding.checkpoint.json",
        ".oak/qmd/index.json",
        ".oak/qmd/context-manifest.md",
        ".oak/demo/demo-output.md",
        "local/profile.toml",
        "local/connectors.toml",
        "workspace/context/assistant-identity.md",
        "workspace/context/user-profile.md",
    ]
    before = {
        item: root_path(item).read_bytes() if root_path(item).exists() else None
        for item in watched
    }
    backup_root = root_path(".oak", "backups")
    backups_before = sorted(str(path.relative_to(root_path())) for path in backup_root.rglob("*")) if backup_root.exists() else []
    gate.run("doctor non-mutating", [str(root_path("scripts", "doctor"))], timeout=60.0)
    after = {
        item: root_path(item).read_bytes() if root_path(item).exists() else None
        for item in watched
    }
    for item in watched:
        if before[item] != after[item]:
            gate.fail(f"doctor mutated live onboarding/local state: {item}")
    backups_after = sorted(str(path.relative_to(root_path())) for path in backup_root.rglob("*")) if backup_root.exists() else []
    if backups_before != backups_after:
        gate.fail("doctor created or changed .oak/backups; diagnostics must not rewrite live onboarding state")


def check_qmd_smoke(gate: Gate) -> None:
    if not shutil.which("qmd"):
        print("qmd binary not found; local fallback was tested instead")
        return
    collection = f"oak-release-{os.getpid()}"
    gate.run(
        "qmd temporary collection",
        ["qmd", "--index", collection, "collection", "add", ".", "--name", collection],
        timeout=20.0,
    )
    output = gate.run(
        "qmd smoke search",
        ["qmd", "--index", collection, "search", "Example Project", "-n", "3", "--files"],
        timeout=20.0,
    )
    subprocess.run(
        ["qmd", "--index", collection, "collection", "remove", collection],
        cwd=root_path(),
        text=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if "examples/synthetic-user" not in output and "example-project" not in output.lower():
        gate.fail("qmd smoke search did not find synthetic example files or generated Example Project files")


def fresh_copy(gate: Gate) -> None:
    with tempfile.TemporaryDirectory(prefix="oak-public-release.") as tmp:
        dst = Path(tmp)
        ignore = shutil.ignore_patterns(".git", ".oak", "local", "workspace", "__pycache__")
        for item in root_path().iterdir():
            if item.name in {".git", ".oak", "local", "workspace", "__pycache__"}:
                continue
            if item.is_dir():
                shutil.copytree(item, dst / item.name, ignore=ignore)
            else:
                shutil.copy2(item, dst / item.name)
        subprocess.run(["git", "init", "-b", "main"], cwd=dst, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        (dst / ".oak").mkdir(exist_ok=True)
        synthetic_blocked_term = f"LOCAL_RELEASE_BLOCK_{os.getpid()}_{int(time.time())}"
        (dst / ".oak" / "release-check-blocklist.txt").write_text(synthetic_blocked_term + "\n", encoding="utf-8")
        scripts = dst / "scripts"
        gate.run("fresh onboarding demo", [str(scripts / "onboard"), "--demo"], cwd=dst, timeout=20.0)
        gate.run("fresh qmd setup", [str(scripts / "qmd-setup"), "--no-register"], cwd=dst, timeout=20.0)
        gate.run("fresh privacy release audit", [str(scripts / "privacy-audit"), "--release", "--include-generated"], cwd=dst, timeout=20.0)
        gate.run("fresh demo", [str(scripts / "demo")], cwd=dst, timeout=20.0)
        gate.run("fresh upgrade dry-run", [str(scripts / "upgrade"), "--dry-run"], cwd=dst, timeout=20.0)
        gate.run("fresh update check", [str(scripts / "update"), "--check-only", "--no-fetch"], cwd=dst, timeout=20.0)
        check_ignored_state(gate, dst)


def check_beginner_onboarding_eval(gate: Gate) -> None:
    gate.run("beginner onboarding eval", [str(root_path("scripts", "eval-onboarding"))], timeout=40.0)


def check_large_workspace_performance(gate: Gate) -> None:
    gate.run("large fixture generation", [str(root_path("scripts", "generate-large-fixture")), "--count", "180"], timeout=20.0)
    gate.run("qmd update large fixture", [str(root_path("scripts", "qmd-update"))], timeout=20.0)
    start = time.perf_counter()
    results = local_search("oak-large-fixture-performance", limit=5)
    elapsed = time.perf_counter() - start
    gate.timings.append(("large fixture local search", elapsed))
    if not any("workspace/perf-large-fixture" in str(item.get("path", "")) for item in results):
        gate.fail("local search did not find the synthetic large workspace fixture")
    for path in ["AGENTS.md", "CLAUDE.md", "docs/context-management.md", ".oak/launch-prompts.md"]:
        full = root_path(path)
        if not full.exists():
            gate.fail(f"missing context discipline file: {path}")
            continue
        text = full.read_text(encoding="utf-8", errors="ignore").lower()
        if "manifests as maps" not in text and "manifests, not expansion" not in text and "search manifest" not in text:
            gate.fail(f"{path} must say manifests are maps, not expansion instructions")


def check_public_export(gate: Gate) -> None:
    gate.run("public export", [str(root_path("scripts", "export-public"))], timeout=30.0)
    manifest_path = root_path(".oak", "export", "latest-export.json")
    if not manifest_path.exists():
        gate.fail("export-public did not write .oak/export/latest-export.json")
        return
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    if manifest.get("status") != "passed":
        gate.fail("export-public reported failed status")
        return
    export_dir = root_path(str(manifest.get("export_dir", "")))
    archive_value = str(manifest.get("archive_path", ""))
    archive_path = root_path(archive_value) if archive_value else Path("")
    if not export_dir.exists():
        gate.fail("export-public folder does not exist")
        return
    if not archive_path.exists():
        gate.fail("export-public archive does not exist")
    forbidden_components = {".git", ".oak", "local", "workspace", "__pycache__", ".pytest_cache", ".venv", "venv", "node_modules"}
    for path in export_dir.rglob("*"):
        rel_parts = path.relative_to(export_dir).parts
        if any(part in forbidden_components for part in rel_parts):
            gate.fail(f"export contains forbidden private/generated path: {path.relative_to(export_dir).as_posix()}")
    with tempfile.TemporaryDirectory(prefix="oak-export-fresh.") as tmp:
        dst = Path(tmp) / "oak-public"
        shutil.copytree(export_dir, dst)
        subprocess.run(["git", "init", "-b", "main"], cwd=dst, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        (dst / ".oak").mkdir(exist_ok=True)
        synthetic_blocked_term = f"LOCAL_RELEASE_BLOCK_{os.getpid()}_{int(time.time())}"
        (dst / ".oak" / "release-check-blocklist.txt").write_text(synthetic_blocked_term + "\n", encoding="utf-8")
        scripts = dst / "scripts"
        gate.run("export privacy release audit", [str(scripts / "privacy-audit"), "--release", "--include-generated"], cwd=dst, timeout=30.0)
        gate.run("export fresh onboarding demo", [str(scripts / "onboard"), "--demo"], cwd=dst, timeout=20.0)
        gate.run("export fresh qmd setup", [str(scripts / "qmd-setup"), "--no-register"], cwd=dst, timeout=20.0)
        gate.run("export fresh demo", [str(scripts / "demo")], cwd=dst, timeout=20.0)
        gate.run("export fresh doctor", [str(scripts / "doctor")], cwd=dst, timeout=60.0)
        check_ignored_state(gate, dst)


def check_perf_benchmark(gate: Gate) -> None:
    gate.run("performance benchmark", [str(root_path("scripts", "perf-benchmark"))], timeout=60.0)
    report_path = root_path(".oak", "perf", "perf-report.json")
    if not report_path.exists():
        gate.fail("perf-benchmark did not write .oak/perf/perf-report.json")
        return
    report = json.loads(report_path.read_text(encoding="utf-8"))
    gate.perf_report = report
    if report.get("status") != "passed":
        gate.fail("perf-benchmark reported failed status")
    for warning in report.get("warnings", []):
        gate.warn(f"perf-benchmark: {warning}")


def write_report(gate: Gate, elapsed: float) -> None:
    status = "publishable" if not gate.failures else "not publishable"
    report = {
        "oak_version": VERSION,
        "status": status,
        "elapsed_seconds": round(elapsed, 3),
        "time_target_seconds": RELEASE_TIME_TARGET_SECONDS,
        "failures": gate.failures,
        "warnings": gate.warnings,
        "timings": [{"name": name, "seconds": round(seconds, 3)} for name, seconds in gate.timings],
        "performance": gate.perf_report or {},
    }
    out_dir = root_path(".oak", "release")
    out_dir.mkdir(parents=True, exist_ok=True)
    (out_dir / "release-check.json").write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    lines = [
        "# Release Readiness Report",
        "",
        f"Status: {status}",
        f"Oak version: {VERSION}",
        f"Elapsed seconds: {elapsed:.2f}",
        f"Time target seconds: {RELEASE_TIME_TARGET_SECONDS:.2f}",
        "",
        "## Failures",
        "",
    ]
    lines.extend([f"- {item}" for item in gate.failures] or ["- none"])
    lines.extend(["", "## Warnings", ""])
    lines.extend([f"- {item}" for item in gate.warnings] or ["- none"])
    lines.extend(["", "## Timings", ""])
    lines.extend(f"- {name}: {seconds:.2f}s" for name, seconds in gate.timings)
    if gate.perf_report:
        perf = gate.perf_report
        metrics = perf.get("metrics", {})
        export = perf.get("export", {})
        baseline = perf.get("baseline", {})
        ux = perf.get("beginner_ux", {})
        runtime = perf.get("runtime_parity", {})
        labels = [
            ("beginner_onboarding_eval", "Beginner onboarding eval"),
            ("qmd_setup_synthetic", "QMD setup over synthetic fixture"),
            ("qmd_update_synthetic", "QMD update over synthetic fixture"),
            ("local_search_synthetic", "Repeated local searches"),
            ("export_public", "Export public"),
            ("update_check", "Update check"),
        ]
        lines.extend(
            [
                "",
                "## Performance Metrics",
                "",
                "| Operation | min | p50 | p95 | max |",
                "| --- | ---: | ---: | ---: | ---: |",
            ]
        )
        for key, label in labels:
            metric = metrics.get(key, {})
            lines.append(
                f"| {label} | {float(metric.get('min', 0.0)):.3f}s | {float(metric.get('p50', 0.0)):.3f}s | {float(metric.get('p95', 0.0)):.3f}s | {float(metric.get('max', 0.0)):.3f}s |"
            )
        lines.extend(
            [
                "",
                "## Export Package",
                "",
                f"- Files: {export.get('file_count', 0)}",
                f"- Zip size: {float(export.get('archive_size_kb', 0.0)):.1f} KB",
                f"- Archive: `{export.get('archive_path', '')}`",
                "",
                "## Baseline Comparison",
                "",
                f"- Status: {baseline.get('status', 'not run')}",
                "",
                "## Beginner UX Metrics",
                "",
                f"- START_HERE lines: {ux.get('start_here_lines', 0)}",
                f"- START_HERE words: {ux.get('start_here_words', 0)}",
                f"- Scripted beginner answers/prompts: {ux.get('scripted_answer_count', 0)}",
                f"- Onboarding question lines observed: {ux.get('question_line_count', 0)}",
                "",
                "## Runtime Parity",
                "",
                f"- Prompt words: {runtime.get('runtime_prompt_words', {})}",
                f"- Runtime doc words: {runtime.get('runtime_doc_words', {})}",
            ]
        )
    (out_dir / "release-readiness-report.md").write_text("\n".join(lines) + "\n", encoding="utf-8")


def main() -> int:
    start = time.perf_counter()
    gate = Gate("release-check")

    section("Oak release check")
    ensure_release_blocklist()
    check_required_files(gate)
    check_readme_beginner_path(gate)
    check_runtime_docs_beginner_sections(gate)
    check_connector_state_language(gate)
    gate.run("python compile", [sys.executable, "-m", "py_compile", *[str(p) for p in root_path("scripts").iterdir() if p.is_file()]], timeout=20.0)
    gate.run("skill validation", [str(root_path("scripts", "validate-skills"))], timeout=10.0)
    gate.run("onboarding demo", [str(root_path("scripts", "onboard")), "--demo"], timeout=20.0)
    check_beginner_onboarding_eval(gate)
    gate.run("qmd setup", [str(root_path("scripts", "qmd-setup")), "--no-register"], timeout=20.0)
    gate.run("demo", [str(root_path("scripts", "demo"))], timeout=20.0)
    check_doctor_non_mutating(gate)
    gate.run("privacy release audit", [str(root_path("scripts", "privacy-audit")), "--release", "--include-generated"], timeout=30.0)
    check_ignored_state(gate)
    check_prompt_generation(gate)
    check_search_first(gate)
    check_external_action_defaults(gate)
    check_docs_claims(gate)
    check_onboarding_issue_release_gate(gate)
    check_personality_onboarding(gate)
    check_capability_matrix(gate)
    check_update_flow(gate)
    check_runtime_update_parity(gate)
    check_generalized_workflow_skills(gate)
    check_current_actions_layer(gate)
    check_session_lifecycle_guidance(gate)
    check_radar_summary_guidance(gate)
    check_generated_outputs(gate)
    check_worker_handoff(gate)
    check_routine_safety(gate)
    check_public_templates(gate)
    check_transcript_adapter_contract(gate)
    check_initial_inbox_scan_skill(gate)
    check_first_domain_project_skill(gate)
    check_large_workspace_performance(gate)
    check_public_demo_no_connector_dependency(gate)
    check_rerun_and_upgrade_safety(gate)
    check_qmd_smoke(gate)
    check_public_export(gate)
    check_perf_benchmark(gate)
    fresh_copy(gate)

    elapsed = time.perf_counter() - start
    if elapsed > RELEASE_TIME_TARGET_SECONDS:
        gate.fail(f"release check exceeded hard threshold: {elapsed:.2f}s > {RELEASE_TIME_TARGET_SECONDS:.2f}s")
    write_report(gate, elapsed)

    if gate.failures:
        print("FAILED")
        for item in gate.failures:
            print(f"- {sanitize_output(item)}")
        return 1
    print("passed")
    if gate.warnings:
        print("warnings:")
        for item in gate.warnings:
            print(f"- {item}")
    print("report: .oak/release/release-readiness-report.md")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
