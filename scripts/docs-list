#!/usr/bin/env python3
from __future__ import annotations

from oak_common import markdown_title, root_path


def main() -> int:
    for path in sorted(root_path("docs").glob("*.md")):
        print(f"{path.relative_to(root_path()).as_posix()} - {markdown_title(path)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
