#!/usr/bin/env python3
from __future__ import annotations

import argparse
import shutil
import sys
from pathlib import Path

from oak_common import build_qmd_index, ensure_dir, local_search, root_path, run_command, section, write_json

QMD_INDEX_NAME = "oak-public"
QMD_COLLECTION_NAME = "oak-workspace"


class RefreshLock:
    def __init__(self, path: Path) -> None:
        self.path = path
        self.acquired = False

    def __enter__(self) -> "RefreshLock":
        try:
            self.path.mkdir(parents=True)
            self.acquired = True
        except FileExistsError:
            self.acquired = False
        return self

    def __exit__(self, *_exc: object) -> None:
        if self.acquired:
            try:
                self.path.rmdir()
            except OSError:
                pass


def append_log(path: Path, message: str) -> None:
    ensure_dir(path.parent)
    with path.open("a", encoding="utf-8") as f:
        f.write(message.rstrip() + "\n")


def collection_points_at_root() -> tuple[bool, str]:
    code, output, _ = run_command(
        ["qmd", "--index", QMD_INDEX_NAME, "collection", "show", QMD_COLLECTION_NAME],
        timeout=10.0,
    )
    if code != 0:
        return False, output
    expected = f"Path:     {root_path().resolve()}"
    return expected in output, output


def main() -> int:
    parser = argparse.ArgumentParser(description="Refresh Oak local search and QMD index.")
    parser.add_argument("--smoke-query", default="Example Project", help="Local smoke-search query.")
    parser.add_argument("--skip-qmd", action="store_true", help="Only refresh the fallback local index.")
    parser.add_argument("--skip-embed", action="store_true", help="Run qmd update but skip qmd embed.")
    parser.add_argument("--log", default=".oak/qmd/refresh.log", help="Local refresh log path.")
    args = parser.parse_args()

    qmd_dir = root_path(".oak", "qmd")
    ensure_dir(qmd_dir)
    log_path = root_path(args.log)

    with RefreshLock(qmd_dir / "refresh.lock") as lock:
        if not lock.acquired:
            section("QMD update")
            print("another qmd refresh is already running; skipped")
            append_log(log_path, "skipped: another qmd refresh is already running")
            return 0

        index = build_qmd_index()
        write_json(qmd_dir / "index.json", index, backup=False)

        section("QMD update")
        print(f"indexed entries: {len(index['entries'])}")
        print("updated .oak/qmd/index.json")
        results = local_search(args.smoke_query, limit=3)
        print(f"local smoke results: {len(results)}")
        append_log(log_path, f"fallback index ok: entries={len(index['entries'])}, smoke_results={len(results)}")

        if args.skip_qmd:
            print("qmd binary refresh skipped by --skip-qmd")
            append_log(log_path, "qmd binary refresh skipped by --skip-qmd")
            return 0

        if not shutil.which("qmd"):
            print("qmd binary not found; fallback local index refreshed")
            append_log(log_path, "qmd binary not found; fallback local index refreshed")
            return 0

        points_at_root, collection_output = collection_points_at_root()
        if not points_at_root:
            print("qmd collection path is missing or does not point at this Oak root; run ./scripts/qmd-setup")
            append_log(log_path, "qmd collection path mismatch or missing")
            append_log(log_path, collection_output)
            return 0

        update_code, update_output, update_elapsed = run_command(
            ["qmd", "--index", QMD_INDEX_NAME, "update"],
            timeout=30.0,
        )
        print("qmd update: passed" if update_code == 0 else "qmd update: failed")
        append_log(log_path, f"qmd update exit={update_code} elapsed={update_elapsed:.2f}s")
        if update_code != 0:
            append_log(log_path, update_output)
            return 1

        if args.skip_embed:
            print("qmd embed skipped by --skip-embed")
            append_log(log_path, "qmd embed skipped by --skip-embed")
            return 0

        embed_code, embed_output, embed_elapsed = run_command(
            ["qmd", "--index", QMD_INDEX_NAME, "embed"],
            timeout=60.0,
        )
        print("qmd embed: passed" if embed_code == 0 else "qmd embed: failed")
        append_log(log_path, f"qmd embed exit={embed_code} elapsed={embed_elapsed:.2f}s")
        if embed_code != 0:
            append_log(log_path, embed_output)
            return 1

    section("QMD update")
    print("refresh complete")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        sys.exit(130)
