#!/usr/bin/env python3
from __future__ import annotations

import argparse
import shutil

from oak_common import (
    VERSION,
    build_qmd_index,
    ensure_dir,
    local_search,
    root_path,
    run_command,
    sanitize_output,
    section,
    write_json,
    write_text,
)

QMD_INDEX_NAME = "oak-public"
QMD_COLLECTION_NAME = "oak-workspace"


def main() -> int:
    parser = argparse.ArgumentParser(description="Set up Oak QMD/local search.")
    parser.add_argument("--no-register", action="store_true", help="Do not register a qmd collection.")
    parser.add_argument("--smoke-query", default="Example Project", help="Search query used for the smoke test.")
    args = parser.parse_args()

    qmd_dir = root_path(".oak", "qmd")
    ensure_dir(qmd_dir)
    write_text(
        qmd_dir / "README.md",
        """# Local QMD State

This folder is generated local state and is ignored by git.

Use `context-manifest.md` as a map. Do not open every listed file by default.
""",
        backup=False,
    )
    write_text(
        qmd_dir / "config.toml",
        f"""oak_version = "{VERSION}"
root = "."
workspace = "workspace"
manifest = ".oak/qmd/context-manifest.md"
index = ".oak/qmd/index.json"
qmd_index_name = "{QMD_INDEX_NAME}"
qmd_collection_name = "{QMD_COLLECTION_NAME}"
search_first = true
manifest_is_not_expansion = true
""",
        backup=False,
    )
    write_json(qmd_dir / "index.json", build_qmd_index(), backup=False)
    local_results = local_search(args.smoke_query, limit=3)
    write_text(
        qmd_dir / "context-manifest.md",
        """# QMD Context Manifest

This is a search manifest, not a file-opening list.

- Prefer QMD/local search before broad scans.
- Open only files needed for the current task.
- Private workspace content may be indexed locally here; do not commit `.oak/`.

Index file: `.oak/qmd/index.json`
Named QMD index: `oak-public`
Collection name: `oak-workspace`
""",
        backup=False,
    )

    section("QMD setup")
    print("created .oak/qmd/config.toml")
    print("created .oak/qmd/context-manifest.md")
    print("created .oak/qmd/index.json")
    print(f"local smoke results: {len(local_results)}")
    for entry in local_results:
        print(f"- {entry['path']}")

    if shutil.which("qmd"):
        print("qmd binary found.")
        if args.no_register:
            print("skipped qmd collection registration because --no-register was provided")
        else:
            code, output, elapsed = run_command(
                [
                    "qmd",
                    "--index",
                    QMD_INDEX_NAME,
                    "collection",
                    "add",
                    ".",
                    "--name",
                    QMD_COLLECTION_NAME,
                ],
                timeout=15.0,
            )
            if code != 0 and "already exists" not in output:
                print("qmd collection registration failed; local fallback remains available")
                print(sanitize_output(output).strip())
            else:
                if "already exists" in output:
                    code, output, elapsed = run_command(
                        ["qmd", "--index", QMD_INDEX_NAME, "update"],
                        timeout=15.0,
                    )
                print(f"qmd collection ready in {elapsed:.2f}s")

            code, status_output, _ = run_command(["qmd", "--index", QMD_INDEX_NAME, "status"], timeout=10.0)
            print("qmd status: passed" if code == 0 else "qmd status: failed")
            code, search_output, _ = run_command(
                [
                    "qmd",
                    "--index",
                    QMD_INDEX_NAME,
                    "search",
                    args.smoke_query,
                    "-n",
                    "3",
                    "--files",
                ],
                timeout=10.0,
            )
            if code == 0 and "examples/synthetic-user" in search_output:
                print("qmd smoke search: passed")
            else:
                print("qmd smoke search: fallback only")
            write_text(
                qmd_dir / "integration.md",
                """# QMD Integration

Oak generated a local index and can also use the QMD CLI when installed.

## Agent Instructions

- Use `qmd --index oak-public search "<query>"` for fast keyword search.
- Use `qmd --index oak-public query "<query>"` when hybrid search is configured.
- Run `qmd mcp` if your runtime supports MCP setup.
- Run `qmd skill show` to view the packaged QMD skill instructions.
- Treat QMD results as leads. Open only the files needed for the task.
""",
                backup=False,
            )
    else:
        print("qmd binary not found. Local manifest/index fallback completed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
